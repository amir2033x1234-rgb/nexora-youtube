# Bind to localhost by default. For a cloud deployment, terminate TLS and require
# authenticated access at a trusted reverse proxy before setting HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3000
NEXORA_DATA_DIR=./data
NEXORA_DAILY_JOB_LIMIT=20
NEXORA_ADMIN_USERNAME=admin
NEXORA_ADMIN_PASSWORD=
# Set true when TLS terminates on a reverse proxy in front of a local app bind.
NEXORA_COOKIE_SECURE=false

# Optional YouTube integration. Set these in a protected local environment only.
# Generate the encryption key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NEXORA_GOOGLE_CLIENT_ID=
NEXORA_GOOGLE_CLIENT_SECRET=
NEXORA_TOKEN_ENCRYPTION_KEY=
# Optional override; default is http://127.0.0.1:<PORT>/api/youtube/oauth/callback
NEXORA_GOOGLE_REDIRECT_URI=

# Optional remote model adapter; loopback and HTTP endpoints are blocked. Verify zero-cost quota before configuring.
NEXORA_OLLAMA_URL=
NEXORA_OLLAMA_MODEL=

# Optional FFmpeg path override. The default command is ffmpeg from PATH.
NEXORA_FFMPEG_PATH=
